# Self-hosted Convex instance (see convex-local-platform). CLI-only — never bundled into the app.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3220
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-contents-of-deployments/<name>/admin-key

# Exposed to the client bundle by Vite — just the URL, no admin key.
VITE_CONVEX_URL=http://127.0.0.1:3220

# App-level auth for every public Convex function (see convex/auth.ts). Must match the
# deployment's SYNC_SECRET env var (set via `npx convex env set SYNC_SECRET <value>`). Low-stakes
# and rotatable, but still never commit the real value here — placeholder only.
SYNC_SECRET=replace-with-a-long-random-value
VITE_SYNC_SECRET=replace-with-the-same-value-as-SYNC_SECRET
